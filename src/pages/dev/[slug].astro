---
import { site } from '@/config';
import '../../styles/global.css';
import Button from '@/core/ui/Button.astro';
import Field from '@/core/ui/Field.astro';
import ErrorSummary from '@/core/ui/ErrorSummary.astro';
import Icon from '@/core/ui/Icon.astro';
import Badge from '@/core/ui/Badge.astro';
import Photo from '@/core/ui/Photo.astro';
import Placeholder from '@/core/ui/Placeholder.astro';
import Card from '@/core/ui/Card.astro';
import Chip from '@/core/ui/Chip.astro';
import Eyebrow from '@/core/ui/Eyebrow.astro';
import Stat from '@/core/ui/Stat.astro';
import { icons, type IconName } from '@/core/ui/icons';

/** The component gallery is a demo tool: a live site does not build it. */
export function getStaticPaths() {
  return site.demoMode ? [{ params: { slug: 'ui' } }] : [];
}

const themes = ['fernway', 'harbour'];
const names = Object.keys(icons) as IconName[];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>UI primitives</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main">
      <h1>UI primitives</h1>
      {themes.map((theme) => (
        <section class="theme" data-theme={theme} aria-labelledby={`h-${theme}`}>
          <h2 id={`h-${theme}`}>Theme: {theme}</h2>
          <div class="row">
            <Button>Book a visit</Button>
            <Button variant="secondary">Call us</Button>
            <Button variant="quiet">Learn more</Button>
            <Button size="lg">Large button</Button>
          </div>
          <div class="row">
            <Badge>Neutral</Badge><Badge tone="success">Open now</Badge><Badge tone="warning">Busy</Badge><Badge tone="danger">Closed</Badge>
          </div>
          <div class="row">
            {names.map((n) => <Icon name={n} size={24} label={n} />)}
          </div>
          <div class="stack-demo">
            <Eyebrow>Section label</Eyebrow>
            <h3>Card heading</h3>
            <Card interactive>
              <h4>Card title</h4>
              <p>Card body copy sits here.</p>
              <Chip href="/">A chip</Chip>
            </Card>
            <Card>
              <h4>Plain card</h4>
              <p>Same card without <code>interactive</code>: hairline border, no hover lift.</p>
            </Card>
            <Card>
              <h4>Composition</h4>
              <p>A nested card and a space-between row both have to reach their container's edges.</p>
              <Card>
                <h5>Nested card</h5>
                <p>This inner card fills its parent rather than shrinking to its text.</p>
              </Card>
              <div class="foot"><span>About this service</span><span>Right edge</span></div>
            </Card>
            <div class="row">
              <Chip pressed={true}>Pressed</Chip>
              <Chip pressed={false}>Unpressed</Chip>
              <Chip>Unset</Chip>
              <Chip href="/">A chip link</Chip>
            </div>
            <div class="stat-row">
              <Stat value="12" label="Services" note="Across every department" icon="badge-check" />
              <Stat value="4.8" label="Average rating" icon="star" />
            </div>
          </div>
          <form class="form" novalidate>
            <ErrorSummary id={`err-${theme}`} />
            <Field name={`name-${theme}`} label="Full name" required autocomplete="name" />
            <Field name={`phone-${theme}`} label="Phone" type="tel" inputmode="tel" hint="We only use this to confirm your visit." />
          </form>
          <div class="row">
            <Photo slot="demo-missing" alt="Reception desk" ratio="16 / 9" />
            <Placeholder label="Treatment room" ratio="4 / 3" />
          </div>
        </section>
      ))}
    </main>
  </body>
</html>

<style>
  main { max-width: 60rem; margin: 0 auto; padding: var(--space-5); }
  .theme { margin-block: var(--space-6); padding: var(--space-5); background: var(--color-paper); color: var(--color-ink); border: 1px solid var(--color-line); }
  .row { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; margin-block: var(--space-4); }
  .row > :global(figure) { flex: 1 1 14rem; }
  .stack-demo { display: grid; gap: var(--space-3); margin-block: var(--space-4); }
  /* Stats get their own grid rather than the shared .row: .row is align-items: center, which
     centre-aligns tiles of unequal height instead of stretching them to a common top edge. */
  .stat-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: var(--space-3); }
  /* Mirrors the ServicesBand foot rule, to prove a space-between row inside a Card still gets free
     space to distribute - which it would not if Card carried justify-items: start. Deliberately a
     <div>, not the <p> ServicesBand uses: global.css caps every p at max-width: var(--measure)
     (68ch, about 749px here). That cap only bites in a card far wider than any production card.
     This gallery's main is 60rem, so the card is 872px of content; ServicesBand's grid is
     repeat(3, 1fr) from 1024px, putting its p-foot near 337px at 1440 and 270px at 1024, where
     68ch never binds. So the gap is a dev-gallery artefact of an unnaturally wide card, not a
     production problem, and the <div> is the right way to isolate Card's own behaviour. Leave
     global.css's measure cap alone. */
  .stack-demo :global(.foot) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2); padding-top: var(--space-2); border-top: var(--hairline); }
  .form { display: grid; gap: var(--space-3); max-width: 24rem; }
</style>
