---
/** Every service as a photo card, with the conditions each one helps. */
import { getCollection } from 'astro:content';
import { site, allSites } from '@/config';
import { rolePhoto, slotPhoto } from '@/config/photo-slots';
import { hasPhoto } from '@/core/photos';
import PageHeader from '@/core/ui/PageHeader.astro';
import { indexPaths, isOn } from '@/domain/modules';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { marketVariants, telHref } from '@/layouts/site';
import CtaBand from '@/sections/CtaBand.astro';
import ServicesBand from '@/sections/ServicesBand.astro';

export function getStaticPaths() {
  return indexPaths('services', site);
}

const services = (await getCollection('services'))
  .map((s) => s.data)
  .sort((a, b) => a.order - b.order)
  .map((s) => ({ ...s, photo: s.photoSlot && hasPhoto(s.photoSlot) ? slotPhoto(s.photoSlot) : undefined }));
const conditions = (await getCollection('conditions')).map((e) => e.data);
const variants = marketVariants(site, allSites()).map((v) => ({ ...v, tel: telHref(v.clinic.phone, v.id) }));
---

<BaseLayout title="Services" description={`Services at ${site.clinic.name}.`}>
  <PageHeader eyebrow="What we treat" title="Services" lede="What we offer, how long it takes and who will see you." photo={rolePhoto(site.contentDir, 'firstVisit')} />
  <ServicesBand services={services} variants={variants} conditions={conditions} title="Choose a service" eyebrow={`${services.length} kinds of care`} lede="Each page says what happens, how long it takes and what it costs." all={false} />
  <CtaBand variants={variants} bookLabel={site.preset.copy.bookLabel} bookingOn={isOn('booking', site)} lede="Not sure which one you need? Call us and we will point you the right way." />
</BaseLayout>
