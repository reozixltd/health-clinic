---
import { site } from '@/config';
import { isOn } from '@/domain/modules';
import BaseLayout from '@/layouts/BaseLayout.astro';
import OwnershipStatement from '@/modules/ownership/OwnershipStatement.astro';
import PageHeader from '@/sections/PageHeader.astro';

if (!isOn('ownership', site)) return new Response(null, { status: 404 });
const { clinic } = site;
---

<BaseLayout title="Who owns us" description={`Who owns ${clinic.name}.`}>
  <PageHeader title="Who owns us" lede="You should know who runs the practice that looks after your pet." />
  <div class="wrap"><OwnershipStatement clinic={clinic} /></div>
</BaseLayout>

<style>
  .wrap { max-width: 72rem; margin: 0 auto; padding: 0 var(--space-4); }
</style>
