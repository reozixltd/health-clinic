---
import { getCollection, getEntry } from 'astro:content';
import { site, allSites } from '@/config';
import { rolePhoto } from '@/config/photo-slots';
import { isOn } from '@/domain/modules';
import { providersBySlug } from '@/modules/providers/lookup';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { hoursText, marketVariants, telHref } from '@/layouts/site';
import CtaBand from '@/sections/CtaBand.astro';
import CoverageBand from '@/sections/CoverageBand.astro';
import Faq from '@/sections/Faq.astro';
import FeesTeaser from '@/sections/FeesTeaser.astro';
import FeaturesBand from '@/sections/FeaturesBand.astro';
import FirstVisit from '@/sections/FirstVisit.astro';
import Hero from '@/sections/Hero.astro';
import Location from '@/sections/Location.astro';
import MetricsBand from '@/sections/MetricsBand.astro';
import ReviewsBand from '@/sections/ReviewsBand.astro';
import ServicesBand from '@/sections/ServicesBand.astro';
import TeamRow from '@/sections/TeamRow.astro';
import TrustRow from '@/sections/TrustRow.astro';
import UrgentBand from '@/sections/UrgentBand.astro';

const { clinic, preset, booking } = site;
const variants = marketVariants(site, allSites()).map((v) => ({ ...v, tel: telHref(v.clinic.phone, v.id), hours: v.clinic.hours.map(hoursText) }));
const on = (id: Parameters<typeof isOn>[0]) => isOn(id, site);

const services = on('services') ? (await getCollection('services')).map((s) => s.data).sort((a, b) => a.order - b.order) : [];
const providers = on('providers') ? (await getCollection('providers')).map((p) => p.data).sort((a, b) => a.name.localeCompare(b.name)) : [];
const acceptingNew = providers.filter((p) => p.acceptingNew).length;
const providerNames = Object.fromEntries([...providersBySlug(providers)].map(([slug, p]) => [slug, p.name]));
const reviews = on('reviews') ? (await getCollection('reviews')).map((r) => r.data) : [];
const faqs = (await getCollection('faqs')).map((f) => f.data).filter((f) => f.tags.includes('home')).slice(0, 5);
const prices = on('price-list') && !on('fees') ? await getEntry('prices', 'prices') : undefined;
const reviewedAt = prices?.data.reviewedAt;
const treats = services.length ? `${preset.copy.treatsLead} ${services.map((s) => s.title.toLowerCase()).join(', ')}.` : '';
const quickLinks = services.slice(0, 4).map((s) => ({ label: s.title, href: `/services/${s.slug}/` }));
const photo = (role: Parameters<typeof rolePhoto>[1]) => rolePhoto(site.contentDir, role);
/* FirstVisit already claims the exterior slot elsewhere on some sites, so the facilities band takes it only when nothing else does. */
const roomPhoto = on('services') ? photo('exterior') : undefined;
---

<BaseLayout title={clinic.name} description={preset.copy.heroLine}>
  <Hero name={clinic.name} treats={treats} preset={preset} variants={variants} bookingOn={on('booking')} emergencyOn={on('emergency')} photo={photo('hero')} quickLinks={quickLinks} acceptingNew={acceptingNew} />
  <TrustRow variants={variants} presetTrust={preset.copy.trust} pricesOn={on('price-list')} ownershipOn={on('ownership')} />
  <div class="stack">
    {on('providers') && <MetricsBand services={services.length} providers={providers.length} acceptingNew={acceptingNew} reviews={reviews} nouns={preset.copy.nouns} variants={variants} />}
    {services.length > 0 && <ServicesBand services={services} providerNames={providerNames} variants={variants} />}
    {providers.length > 0 && <TeamRow providers={providers} variants={variants} />}
    <FirstVisit bookingOn={on('booking')} confirmPromise={booking.confirmPromise} items={preset.copy.firstVisit} photo={photo('firstVisit')} />
    {on('emergency') && <UrgentBand variants={variants} preset={preset} emergencyOn={on('emergency')} hours={Object.fromEntries(variants.map((v) => [v.id, v.hours]))} />}
    <FeesTeaser variants={variants} feesOn={on('fees')} priceListOn={on('price-list')} reviewedAt={reviewedAt} />
    <CoverageBand feesOn={on('fees')} priceListOn={on('price-list')} />
    {on('reviews') && <ReviewsBand items={reviews} variants={variants} />}
    <Location variants={variants} />
    {roomPhoto && <FeaturesBand photo={roomPhoto} />}
    {faqs.length > 0 && <Faq items={faqs} />}
    <CtaBand variants={variants} bookLabel={preset.copy.bookLabel} bookingOn={on('booking')} />
  </div>
</BaseLayout>

<style>
  .stack { max-width: 72rem; margin: 0 auto; padding: var(--space-6) var(--space-4) 0; display: grid; gap: var(--space-8); }
  .stack > :global(section) { display: grid; gap: var(--space-4); align-content: start; }
  .stack :global(h2) { font-size: var(--text-28); }
</style>
