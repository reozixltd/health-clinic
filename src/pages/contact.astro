---
import { getEntry, render } from 'astro:content';
import { site, allSites } from '@/config';
import { rolePhoto } from '@/config/photo-slots';
import Icon from '@/core/ui/Icon.astro';
import PageHeader from '@/core/ui/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { hoursText, marketVariants, telHref } from '@/layouts/site';
import Location from '@/sections/Location.astro';

const entry = await getEntry('policies', 'contact');
if (!entry) throw new Error('Missing policy content: contact');
const { Content } = await render(entry);
const variants = marketVariants(site, allSites()).map((v) => ({ ...v, tel: telHref(v.clinic.phone, v.id), hours: v.clinic.hours.map(hoursText) }));
---

<BaseLayout title="Contact" description={`Contact ${site.clinic.name}: phone, email, opening hours and how to find us.`}>
  <PageHeader title="Contact" eyebrow="Get in touch" lede="Where we are, when we are open and how to reach us." photo={rolePhoto(site.contentDir, 'exterior')} />
  <div class="wrap reach">
    {variants.map((v) => (
      <ul class="cards" data-market-only={v.id}>
        <li class="panel">
          <span class="icon"><Icon name="phone" size={22} /></span>
          <h2>Call us</h2>
          <p><a href={v.tel}>{v.clinic.phone}</a></p>
          {v.clinic.mobile && <p><a href={telHref(v.clinic.mobile, v.id)}>{v.clinic.mobile}</a></p>}
          <p class="note">{v.hours[0]}</p>
        </li>
        <li class="panel">
          <span class="icon"><Icon name="mail" size={22} /></span>
          <h2>Email us</h2>
          <p><a href={`mailto:${v.clinic.email}`}>{v.clinic.email}</a></p>
          <p class="note">We reply on the next working day.</p>
        </li>
        <li class="panel urgent">
          <span class="icon"><Icon name="alert" size={22} /></span>
          <h2>In an emergency</h2>
          <p class="note">{v.clinic.emergency.text}</p>
        </li>
      </ul>
    ))}
  </div>
  <Location variants={variants} />
  <div class="wrap page-body notes">
    <div class="prose"><Content /></div>
  </div>
</BaseLayout>

<style>
  .reach { padding-top: var(--space-7); }
  .cards { display: grid; gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
  @media (min-width: 768px) { .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .cards li { display: grid; gap: var(--space-2); align-content: start; justify-items: start; }
  .icon { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: var(--radius-card); background: var(--color-accent); color: var(--color-primary-text); }
  .urgent .icon { background: var(--color-warning-soft); color: var(--color-ink); }
  h2 { font-size: var(--text-20); }
  .cards a { display: inline-flex; align-items: center; min-height: var(--target); font-size: var(--text-18); font-weight: 600; overflow-wrap: anywhere; }
  .note { color: var(--color-ink-muted); font-size: var(--text-14); }
  .notes { padding-top: 0; }
</style>
