---
import { site, allSites } from '@/config';
import { rolePhoto } from '@/config/photo-slots';
import Photo from '@/core/ui/Photo.astro';
import { hoursText, marketVariants, telHref } from '@/layouts/site';
import PolicyPage from '@/layouts/PolicyPage.astro';

const variants = marketVariants(site, allSites());
const photo = rolePhoto(site.contentDir, 'exterior');
---

<PolicyPage policy="contact" lede="Where we are, when we are open and how to reach us.">
  <div slot="before" class:list={['details', photo && 'has-photo']}>
    <div>
      {variants.map((v) => (
        <div class="detail" data-market-only={v.id}>
          <h2>Find us</h2>
          <address>{v.clinic.address.street}, {v.clinic.address.locality} {v.clinic.address.region} {v.clinic.address.postcode}</address>
          <p><a href={telHref(v.clinic.phone, v.id)}>{v.clinic.phone}</a></p>
          {v.clinic.mobile && <p><a href={telHref(v.clinic.mobile, v.id)}>{v.clinic.mobile}</a></p>}
          <p><a href={`mailto:${v.clinic.email}`}>{v.clinic.email}</a></p>
          <h2>Opening hours</h2>
          <ul>{v.clinic.hours.map((h) => <li>{hoursText(h)}</li>)}</ul>
          <p>{v.clinic.emergency.text}</p>
        </div>
      ))}
    </div>
    {photo && <Photo slot={photo.slot} alt={photo.alt} ratio="4 / 3" sizes="(min-width: 768px) 50vw, 100vw" />}
  </div>
</PolicyPage>

<style>
  .details { display: grid; gap: var(--space-5); max-width: var(--measure); }
  @media (min-width: 768px) { .details.has-photo { max-width: none; grid-template-columns: 1fr 1fr; align-items: start; column-gap: var(--space-7); } }
  .detail { display: grid; gap: var(--space-2); }
  h2 { margin: var(--space-3) 0 0; font-size: var(--text-22); }
  address { font-style: normal; }
  ul { list-style: none; margin: 0; padding: 0; }
  p { margin: 0; }
  a { display: inline-flex; align-items: center; min-height: var(--target); }
</style>
