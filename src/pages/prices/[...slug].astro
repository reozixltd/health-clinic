---
import { getEntry } from 'astro:content';
import { site } from '@/config';
import { formatDate, formatMoney } from '@/core/format';
import { indexPaths, isOn } from '@/domain/modules';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { configuredMarket } from '@/layouts/site';
import PriceList from '@/modules/price-list/PriceList.astro';
import PageHeader from '@/core/ui/PageHeader.astro';

export function getStaticPaths() {
  return indexPaths('price-list', site);
}

const { clinic } = site;
const market = configuredMarket(site);
const entry = await getEntry('prices', 'prices');
if (!entry) throw new Error('Price list is on but prices.json is missing.');
const { items, reviewedAt } = entry.data;
const threshold = clinic.estimateThreshold ?? 500;
---

<BaseLayout title="Prices" description={`Our prices for common treatments at ${clinic.name}. ${market.taxNote}.`}>
  <PageHeader title="Our prices" eyebrow="Clear pricing" lede="What common treatments cost, listed up front." crumbs={[{ label: 'Prices' }]} />
  <div class="wrap page-body">
    <PriceList items={items} market={market} reviewedLabel={formatDate(reviewedAt, market.locale)} />
    {isOn('estimates', site) && (
      <p class="after">For treatment likely to cost {formatMoney(threshold, market.currency, market.locale)} or more, we give you a written estimate first. <a href="/estimates/">Ask for an estimate</a>.</p>
    )}
  </div>
</BaseLayout>

<style>
  .after { font-size: var(--text-18); }
  .after a { color: var(--color-primary-text); font-weight: 600; }
</style>
