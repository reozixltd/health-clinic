---
import { site } from '@/config';
import Button from '@/core/ui/Button.astro';
import PageHeader from '@/core/ui/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page does not exist." noindex>
  <PageHeader title="We could not find that page" eyebrow="Error 404" lede="It may have moved, or the link may be wrong.">
    <p class="actions">
      <Button href="/" arrow>Go to the home page</Button>
      <Button href="/contact/" variant="secondary">Contact {site.clinic.name}</Button>
    </p>
  </PageHeader>
</BaseLayout>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-3); }
</style>
