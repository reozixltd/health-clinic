---
import { site } from '@/config';
import { formatMoney } from '@/core/format';
import { indexPaths } from '@/domain/modules';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { configuredMarket, telHref } from '@/layouts/site';
import EstimateForm from '@/modules/estimates/EstimateForm.astro';
import PageHeader from '@/core/ui/PageHeader.astro';

export function getStaticPaths() {
  return indexPaths('estimates', site);
}

const { clinic } = site;
const market = configuredMarket(site);
const threshold = formatMoney(clinic.estimateThreshold ?? 500, market.currency, market.locale);
---

<BaseLayout title="Request an estimate" description={`Ask ${clinic.name} for a written estimate before planned treatment.`}>
  <PageHeader title="Request an estimate" lede={`We give you a written estimate before treatment that is likely to cost ${threshold} or more.`} />
  <div class="wrap page-body">
    <p class="intro">Tell us your pet and what the treatment is for. A vet or nurse will email you. Please do not put health details in this form. We will ask about those when we speak.</p>
    <div class="panel"><EstimateForm siteId={site.id} demo={site.demoMode} market={market} phone={clinic.phone} phoneHref={telHref(clinic.phone, market.id)} /></div>
  </div>
</BaseLayout>

<style>
  .intro { font-size: var(--text-18); }
  .panel { max-width: 40rem; }
</style>
