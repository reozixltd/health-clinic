---
import { site } from '@/config';
import { indexPaths } from '@/domain/modules';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { configuredMarket, telHref } from '@/layouts/site';
import OwnershipStatement from '@/modules/ownership/OwnershipStatement.astro';
import PageHeader from '@/core/ui/PageHeader.astro';

export function getStaticPaths() {
  return indexPaths('ownership', site);
}

const { clinic } = site;
---

<BaseLayout title="Who owns us" description={`Who owns ${clinic.name}.`}>
  <PageHeader title="Who owns us" lede="You should know who runs the practice that looks after your pet." />
  <div class="wrap page-body"><div class="panel"><OwnershipStatement clinic={clinic} phoneHref={telHref(clinic.phone, configuredMarket(site).id)} /></div></div>
</BaseLayout>

<style>
  .panel { max-width: 48rem; }
</style>
