---
import { getCollection } from 'astro:content';
import { site, allSites } from '@/config';
import { indexPaths } from '@/domain/modules';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { marketVariants, telHref } from '@/layouts/site';
import ReferralForm from '@/modules/referrals/ReferralForm.astro';
import PageHeader from '@/core/ui/PageHeader.astro';

export function getStaticPaths() {
  return indexPaths('referrals', site);
}

const { clinic } = site;
const services = (await getCollection('services')).map((s) => s.data).sort((a, b) => a.order - b.order);
const variants = marketVariants(site, allSites()).map((v) => ({ ...v, tel: telHref(v.clinic.phone, v.id) }));
---

<BaseLayout title="For referrers" description={`Refer a patient to ${clinic.name}.`}>
  <PageHeader title="For referrers" eyebrow="Health professionals" lede="Send us a patient and we will take it from there." crumbs={[{ label: 'Referrers' }]} />
  <div class="wrap page-body cols">
    <div class="prose">
      <h2 id="how">How to refer</h2>
      <p>Fill in the form with your details, the patient's first name and phone number, the service and how soon. We contact the patient to book them in.</p>
      <p>
        Prefer to call? Ring us on{" "}
        {variants.map((v) => <a data-market-only={v.id} href={v.tel}>{v.clinic.phone}</a>)}.
      </p>
      <h2 id="secure">Clinical details</h2>
      <p>This form does not take clinical details. Please send them through your secure channel or by fax, not here.</p>
      <h2 id="treat">What we treat</h2>
      <ul>
        {services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.title}</a>: {s.summary}</li>)}
      </ul>
    </div>
    <section class="panel" aria-labelledby="form">
      <h2 id="form">Referral form</h2>
      <ReferralForm siteId={site.id} demo={site.demoMode} services={services} variants={variants} />
    </section>
  </div>
</BaseLayout>

<style>
  .cols { align-items: start; }
  .panel { display: grid; gap: var(--space-5); }
  .panel h2 { font-size: var(--text-24); }
  @media (min-width: 1024px) { .cols { grid-template-columns: minmax(0, 1fr) minmax(0, 30rem); gap: var(--space-8); } }
</style>
