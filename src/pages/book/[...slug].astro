---
import { getCollection } from 'astro:content';
import { allSites, site } from '@/config';
import { indexPaths, isOn } from '@/domain/modules';
import BookingForm from '@/modules/booking/BookingForm.astro';
import ConfirmationPreview from '@/modules/reminders/ConfirmationPreview.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { configuredMarket, marketVariants, telHref } from '@/layouts/site';
import Button from '@/core/ui/Button.astro';
import Icon from '@/core/ui/Icon.astro';
import PageHeader from '@/core/ui/PageHeader.astro';

export function getStaticPaths() {
  return indexPaths('booking', site);
}

const variants = marketVariants(site, allSites());
const configured = configuredMarket(site);
const services = (await getCollection('services')).map((s) => s.data).sort((a, b) => a.order - b.order);
const providers = (await getCollection('providers')).map((p) => p.data);
// The sample confirmation text is a demo feature of the reminders module.
const confirmation = site.demoMode && isOn('reminders', site) ? site.messages.find((m) => m.id === 'confirmation') : undefined;
const data = {
  siteId: site.id,
  marketId: configured.id,
  phones: Object.fromEntries(variants.map((v) => [v.id, v.clinic.phone])),
  hrefs: Object.fromEntries(variants.map((v) => [v.id, telHref(v.clinic.phone, v.id)])),
  timeZones: Object.fromEntries(variants.map((v) => [v.id, v.clinic.timeZone])),
  preset: site.preset.id,
  clinicName: site.clinic.name,
  booking: site.booking,
  demo: site.demoMode,
  services: services.map(({ slug, title, summary }) => ({ slug, title, summary })),
  providers: providers.map(({ slug, name, role, services: offered, acceptingNew }) => ({ slug, name, role, services: offered, acceptingNew })),
};
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<BaseLayout title={`Request an appointment | ${site.clinic.name}`} description={`Ask for a time at ${site.clinic.name}. It takes about two minutes and we confirm ${site.booking.confirmPromise}.`} hideMobileBar>
  <PageHeader title="Request an appointment" eyebrow="Book online" crumbs={[{ label: 'Book' }]} lede={`It takes about two minutes. We'll confirm the time ${site.booking.confirmPromise}.`} />
  <div id="booking-root">
    <BookingForm
      clinicName={site.clinic.name}
      preset={site.preset.id}
      {variants}
      phones={variants.map((v) => ({ id: v.id, phone: v.clinic.phone, href: telHref(v.clinic.phone, v.id) }))}
      booking={site.booking}
      services={data.services}
      providers={data.providers}
    />
    <section class="sent" id="booking-sent" aria-labelledby="sent-title" tabindex="-1" hidden>
      <div class="panel">
        <span class="tick"><Icon name="check" size={28} /></span>
        <h2 id="sent-title">Appointment request sent</h2>
        <p>We'll confirm by SMS {site.booking.confirmPromise}.</p>
        {confirmation && <ConfirmationPreview body={confirmation.body} clinicName={site.clinic.name} />}
        <Button href="/" variant="secondary">Back to the home page</Button>
      </div>
    </section>
  </div>
  <script type="application/json" id="booking-data" set:html={json} is:inline></script>
</BaseLayout>

<script>
  import { getLeadRepository } from '@/core/leads';
  import { todayIn } from '@/core/format';
  import { getMarket, type MarketId } from '@/domain/markets';
  import type { BookingConfig, Provider, Service } from '@/domain/types';
  import { initBooking } from '@/modules/booking/booking';
  import { availableDays } from '@/modules/booking/state';

  const data = JSON.parse(document.getElementById('booking-data')!.textContent!) as {
    siteId: string; marketId: MarketId; preset: 'allied-health' | 'vet'; clinicName: string; phones: Record<string, string>; hrefs: Record<string, string>; timeZones: Record<string, string>;
    booking: BookingConfig; demo: boolean; services: Service[]; providers: Provider[];
  };
  // Same resolution as the rest of the site: ThemeBoot sets html[data-market] (build market unless ?market= is allowed).
  const active = (document.documentElement.getAttribute('data-market') as MarketId | null) ?? data.marketId;
  const market = getMarket(active);
  const root = document.querySelector<HTMLElement>('[data-booking]')!;
  const sent = document.getElementById('booking-sent')!;
  const windows = data.booking.windows;

  initBooking(root, {
    repo: getLeadRepository(`health:v1:${data.siteId}`, { demo: data.demo }),
    fallbackPhone: data.phones[active] ?? Object.values(data.phones)[0]!,
    fallbackHref: data.hrefs[active] ?? Object.values(data.hrefs)[0]!,
    data: { services: data.services, providers: data.providers, windows, preset: data.preset, market, booking: data.booking,
      days: availableDays(todayIn(data.timeZones[active] ?? Object.values(data.timeZones)[0]!, new Date()), data.booking, market.locale) },
    onSent(lead) {
      const p = lead.payload;
      root.querySelector('form')!.hidden = true;
      root.querySelector('.progress')!.setAttribute('hidden', '');
      // Pages with the reminders module on listen for this and show a sample confirmation text.
      window.dispatchEvent(new CustomEvent('booking:sent', { detail: {
        firstName: lead.contact.firstName,
        dayLabel: root.querySelector('[data-line="Day"] dd')?.textContent ?? p.day,
        windowLabel: windows.find((w) => w.id === p.windowId)?.label ?? '',
      } }));
      sent.hidden = false;
      sent.focus();
    },
  });
</script>

<style>
  .sent { width: min(100% - var(--gutter) * 2, 40rem); margin-inline: auto; padding-block: var(--space-7) var(--space-5); }
  .sent:focus { outline: none; }
  .panel { display: grid; gap: var(--space-3); justify-items: start; }
  .tick { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; background: var(--color-success-soft); border-radius: 50%; color: var(--color-success); }
  h2 { font-size: var(--text-28); }
  /* Once sent, the message leads and the filled card sits under it as the summary. */
  #booking-root:has(#booking-sent:not([hidden])) { display: grid; }
  #booking-root:has(#booking-sent:not([hidden])) :global(.book) { order: 2; grid-template-columns: minmax(0, 40rem); justify-content: center; padding-top: 0; }
  #booking-root:has(#booking-sent:not([hidden])) :global(.book__card) { grid-column: 1; position: static; }
  #booking-root:has(#booking-sent:not([hidden])) :global(.book__main) { display: none; }
</style>
