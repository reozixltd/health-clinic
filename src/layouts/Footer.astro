---
/** Deep, multi-column footer: who we are, the services, the site map, where to find us, then the legal line. */
import { getCollection } from 'astro:content';
import { site, allSites } from '@/config';
import Icon from '@/core/ui/Icon.astro';
import OpenStatus from '@/core/ui/OpenStatus.astro';
import { hoursText, marketVariants, pageLabel, telHref } from './site';

const variants = marketVariants(site, allSites());
const links = site.preset.nav;
const mission = site.modules.includes('about') ? (await getCollection('about'))[0]?.data.mission : undefined;
const services = site.modules.includes('services')
  ? (await getCollection('services')).map((s) => s.data).sort((a, b) => a.order - b.order).slice(0, 6)
  : [];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap cols">
    <div class="brand">
      <a class="wordmark" href="/">
        <span class="mark" aria-hidden="true">{site.clinic.name.charAt(0)}</span>
        {site.clinic.name}
      </a>
      {mission && <p class="mission">{mission}</p>}
      {variants.map((v) => (
        <div class="reach" data-market-only={v.id}>
          <OpenStatus class="open" hours={v.clinic.hours} timeZone={v.clinic.timeZone} fallback={v.clinic.hours[0] ? hoursText(v.clinic.hours[0]) : ''} />
          <a href={telHref(v.clinic.phone, v.id)}><Icon name="phone" size={18} /> {v.clinic.phone}</a>
          <a href={`mailto:${v.clinic.email}`}><Icon name="mail" size={18} /> {v.clinic.email}</a>
        </div>
      ))}
    </div>
    {services.length > 0 && (
      <nav aria-label="Services">
        <h2>{site.preset.copy.nouns.service}</h2>
        <ul>
          {services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.title}</a></li>)}
        </ul>
      </nav>
    )}
    <nav aria-label="Footer">
      <h2>Clinic</h2>
      <ul>
        {links.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="/faq/">Questions</a></li>
      </ul>
    </nav>
    {variants.map((v) => (
      <div class="identity" data-market-only={v.id}>
        <h2>Visit us</h2>
        <address>
          {v.clinic.address.street}<br />
          {v.clinic.address.locality} {v.clinic.address.region} {v.clinic.address.postcode}
        </address>
        <ul class="hours">
          {v.clinic.hours.map((h) => <li>{hoursText(h)}</li>)}
        </ul>
        <p>{v.clinic.emergency.text}</p>
      </div>
    ))}
  </div>
  <div class="wrap legal">
    {variants.map((v) => (
      <p class="id" data-market-only={v.id}>
        <span>&copy; {year} {v.clinic.legalName}</span>
        <span>{v.market.legalIdLabel} {v.clinic.legalId}</span>
      </p>
    ))}
    <ul class="policies">
      {site.market.requiredPages.map((p) => <li><a href={p}>{pageLabel(p)}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-9); padding-top: var(--space-8);
    background: var(--color-deep); color: var(--color-on-deep-muted); font-size: var(--text-16);
    --color-focus: var(--color-on-deep); --open-dot: var(--color-accent);
  }
  .cols { display: grid; gap: var(--space-7) var(--space-6); padding-bottom: var(--space-7); }
  @media (min-width: 640px) { .cols { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .cols { grid-template-columns: 1.5fr 1fr 1fr 1.25fr; } }
  h2 { margin-bottom: var(--space-3); color: var(--color-on-deep); font-family: var(--font-body); font-size: var(--text-14); font-weight: 700; letter-spacing: var(--track-label); text-transform: uppercase; }
  ul { list-style: none; margin: 0; padding: 0; }
  a { color: var(--color-on-deep); text-decoration: none; }
  li a, .reach a { display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--target); }
  .brand { display: grid; gap: var(--space-4); align-content: start; }
  @media (min-width: 640px) and (max-width: 1023px) { .brand { grid-column: 1 / -1; } }
  .wordmark { display: inline-flex; align-items: center; gap: var(--space-3); min-height: var(--target); font-family: var(--font-display); font-size: var(--text-24); font-weight: 600; letter-spacing: var(--track-heading); }
  .mark {
    display: grid; place-items: center; width: 2.5rem; height: 2.5rem;
    background: var(--color-accent); color: var(--color-primary-text);
    border-radius: 42% 58% 55% 45% / 52% 44% 56% 48%; font-size: var(--text-20);
  }
  .mission { max-width: 34ch; }
  .reach { display: grid; justify-items: start; }
  .reach :global(.open) { min-height: var(--target); color: var(--color-on-deep); }
  .identity { display: grid; gap: var(--space-3); align-content: start; }
  .identity h2 { margin-bottom: 0; }
  address { font-style: normal; }
  .legal {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2) var(--space-6);
    padding-block: var(--space-4); border-top: 1px solid color-mix(in srgb, var(--color-on-deep) 16%, transparent); font-size: var(--text-14);
  }
  /* One class only: a longer selector would outrank the rule that hides the other market's line. */
  .id { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-5); }
  .policies { display: flex; flex-wrap: wrap; gap: 0 var(--space-5); }
  @media (hover: hover) and (pointer: fine) { a:hover { text-decoration: underline; } }
</style>
