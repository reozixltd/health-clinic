---
import '@/styles/global.css';
import { site } from '@/config';
import DemoRibbon from './DemoRibbon.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import MobileBar from './MobileBar.astro';
import Motion from './Motion.astro';
import Seo from './Seo.astro';
import ThemeBoot from './ThemeBoot.astro';

interface Props {
  title: string;
  description: string;
  schema?: object | object[];
  noindex?: boolean;
  /** Skip header, footer and ribbon (console, print views). */
  bare?: boolean;
  hideMobileBar?: boolean;
}

const { title, description, schema, noindex, bare = false, hideMobileBar = false } = Astro.props;
// Page to page: a short cross-fade in browsers with cross-document view transitions, and a card photo that grows into the photo on its detail page (core/morph.ts). Others navigate as usual.
// Inline and only here, so the console and bare pages never get it. The global reduce-motion rule is not enough: the transition is a browser feature, not an animation on an element.
const viewTransitionCss = `@media (prefers-reduced-motion: no-preference) { @view-transition { navigation: auto; } }
::view-transition-old(root), ::view-transition-new(root) { animation-duration: var(--dur-2); }
::view-transition-group(*.morph) { animation-duration: var(--dur-3); animation-timing-function: var(--ease-out); }
::view-transition-old(*.morph), ::view-transition-new(*.morph) { height: 100%; object-fit: cover; overflow: clip; animation-duration: var(--dur-3); }`;
---

<!doctype html>
<html lang={site.market.locale} data-theme={site.theme} data-market={site.market.id} data-motion={site.motion ? undefined : 'off'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeBoot />
    <Seo {title} {description} {schema} {noindex} />
    {site.motion && !bare && <style is:inline set:html={viewTransitionCss} />}
  </head>
  <body data-mobile-bar={!bare && !hideMobileBar ? '' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    {!bare && site.demoMode && <DemoRibbon />}
    {!bare && <Header />}
    <main id="main" tabindex="-1"><slot /></main>
    {!bare && <Footer />}
    {!bare && !hideMobileBar && <MobileBar />}
    {site.motion && !bare && <Motion />}
  </body>
</html>
