---
import { site, allSites } from '@/config';
import Button from '@/core/ui/Button.astro';
import Icon from '@/core/ui/Icon.astro';
import { marketVariants, telHref } from './site';

const variants = marketVariants(site, allSites());
const links = site.preset.nav.filter((n) => !n.footer);
const booking = site.modules.includes('booking');
---

<header class="header">
  <div class="bar">
    <a class="wordmark" href="/">{site.clinic.name}</a>
    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {links.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
    {variants.map((v) => (
      <a class="call" data-market-only={v.id} href={telHref(v.clinic.phone, v.id)} aria-label={`Call ${v.clinic.phone}`}>
        <Icon name="phone" />
        <span>{v.clinic.phone}</span>
      </a>
    ))}
    {booking && <div class="book"><Button href="/book/">{site.preset.copy.bookLabel}</Button></div>}
    <button class="menu" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
      <Icon name="menu" />
    </button>
  </div>
</header>

<script>
  import { initMenu } from './site';
  initMenu();
</script>

<style>
  .header { background: var(--color-paper); border-bottom: 1px solid var(--color-line); position: relative; }
  .bar { display: flex; align-items: center; gap: var(--space-4); max-width: 72rem; margin: 0 auto; padding: var(--space-3) var(--space-4); }
  .wordmark { font-weight: 700; font-size: var(--text-18); text-decoration: none; min-height: var(--target); display: inline-flex; align-items: center; margin-right: auto; }
  .nav ul { display: flex; gap: var(--space-2); list-style: none; margin: 0; padding: 0; }
  .nav a { display: inline-flex; align-items: center; min-height: var(--target); padding: 0 var(--space-3); text-decoration: none; }
  .nav a:hover { text-decoration: underline; }
  .call { display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--target); font-weight: 600; text-decoration: none; }
  .menu { display: none; min-width: var(--target); min-height: var(--target); align-items: center; justify-content: center; background: transparent; border: 1px solid var(--color-field-border); border-radius: var(--radius-control); }
  @media (max-width: 1023px) {
    .menu { display: inline-flex; }
    .call span, .book { display: none; }
    .nav { display: none; position: absolute; left: 0; right: 0; top: 100%; background: var(--color-paper); border-bottom: 1px solid var(--color-line); padding: var(--space-2) var(--space-4); z-index: 20; }
    .nav[data-open] { display: block; }
    .nav ul { flex-direction: column; }
  }
</style>
