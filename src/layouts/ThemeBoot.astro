---
/** Pre-paint script: applies theme and market before first render. Demo sites only honour ?theme= and ?market=. */
import { site } from '@/config';
import { getMarket } from '@/domain/markets';

const config = {
  id: site.id,
  demo: site.demoMode,
  theme: site.theme,
  themes: site.themes,
  market: site.market.id,
  markets: site.markets,
  locales: Object.fromEntries(site.markets.map((id) => [id, getMarket(id).locale])),
};
---

<script is:inline define:vars={{ config }}>
  (function () {
    var root = document.documentElement;
    var query = new URLSearchParams(location.search);
    function pick(name, allowed, configured) {
      if (!config.demo) return configured;
      var key = 'health:v1:' + config.id + ':' + name;
      var param = query.get(name);
      var stored = null;
      try { stored = sessionStorage.getItem(key); } catch (e) {}
      if (param && allowed.indexOf(param) > -1) {
        try { sessionStorage.setItem(key, param); } catch (e) {}
        return param;
      }
      return stored && allowed.indexOf(stored) > -1 ? stored : configured;
    }
    var market = pick('market', config.markets, config.market);
    root.setAttribute('data-theme', pick('theme', config.themes, config.theme));
    root.setAttribute('data-market', market);
    root.setAttribute('lang', config.locales[market] || root.lang);
  })();
</script>
