---
/** A Markdown content page from the policies collection (HTML allowed, so data-market-only blocks work). */
import { getEntry, render } from 'astro:content';
import { formatDate } from '@/core/format';
import Icon from '@/core/ui/Icon.astro';
import PageHeader from '@/core/ui/PageHeader.astro';
import { site } from '@/config';
import BaseLayout from './BaseLayout.astro';

interface Props {
  policy: string;
  lede?: string;
  eyebrow?: string;
  /** Show the "Last updated" line (legal pages). */
  dated?: boolean;
}
const { policy, lede, eyebrow, dated = false } = Astro.props;
const entry = await getEntry('policies', policy);
if (!entry) throw new Error(`Missing policy content: ${policy}`);
const { Content } = await render(entry);
const updated = entry.data.updated.toISOString().slice(0, 10);
---

<BaseLayout title={entry.data.title} description={`${entry.data.title} at ${site.clinic.name}.`}>
  <PageHeader title={entry.data.title} lede={lede} eyebrow={eyebrow}>
    {dated && <p class="updated"><Icon name="clock" size={16} /> Last updated <time datetime={updated}>{formatDate(updated, site.market.locale)}</time></p>}
  </PageHeader>
  <div class="wrap page-body">
    <slot name="before" />
    <div class="prose"><Content /></div>
    <slot />
  </div>
</BaseLayout>

<style>
  .updated { display: flex; align-items: center; gap: var(--space-2); color: var(--color-ink-muted); font-size: var(--text-14); }
</style>
