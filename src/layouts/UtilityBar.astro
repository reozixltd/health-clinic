---
/** Thin row above the header: open now or closed, the after-hours line, the address and the phone number. */
import { site, allSites } from '@/config';
import Icon from '@/core/ui/Icon.astro';
import OpenStatus from '@/core/ui/OpenStatus.astro';
import { hoursText, marketVariants, telHref } from './site';

const variants = marketVariants(site, allSites());
---

<div class="utility" data-utility>
  {variants.map((v) => (
    <div class="inner wrap" data-market-only={v.id}>
      <OpenStatus class="open" hours={v.clinic.hours} timeZone={v.clinic.timeZone} fallback={v.clinic.hours[0] ? hoursText(v.clinic.hours[0]) : ''} />
      <p class="urgent">{v.clinic.emergency.text}</p>
      <p class="where">
        <Icon name="map-pin" size={16} />
        {v.clinic.address.street}, {v.clinic.address.locality} {v.clinic.address.region} {v.clinic.address.postcode}
      </p>
      <a class="call" href={telHref(v.clinic.phone, v.id)}>
        <Icon name="phone" size={16} />
        {v.clinic.phone}
      </a>
    </div>
  ))}
</div>

<style>
  .utility { background: var(--color-deep); color: var(--color-on-deep-muted); font-size: var(--text-14); --color-focus: var(--color-on-deep); --open-dot: var(--color-accent); }
  .inner { display: flex; align-items: center; gap: var(--space-5); height: var(--utility-h); }
  p { margin: 0; white-space: nowrap; }
  .inner :global(.open) { flex: none; color: var(--color-on-deep); white-space: nowrap; }
  .where { align-items: center; gap: var(--space-2); }
  .urgent, .where { display: none; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .where { margin-left: auto; }
  .call { flex: none; display: inline-flex; white-space: nowrap; align-items: center; gap: var(--space-2); min-height: var(--target); margin-left: auto; color: var(--color-on-deep); font-weight: 600; text-decoration: none; }
  /* On the narrowest screens the status keeps the row; the header and the bottom bar both carry a call button. */
  @media (max-width: 479px) { .call { display: none; } }
  @media (min-width: 768px) { .urgent { display: block; } }
  @media (min-width: 1200px) { .where { display: inline-flex; } .call { margin-left: 0; } }
  @media (hover: hover) and (pointer: fine) { .call:hover { text-decoration: underline; } }
</style>
