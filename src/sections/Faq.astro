---
/** Five questions tagged home. */
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<section id="faq" aria-labelledby="faq-title">
  <h2 id="faq-title">Common questions</h2>
  <dl>
    {items.map((f) => (<><dt>{f.q}</dt><dd>{f.a}</dd></>))}
  </dl>
</section>

<style>
  dl { margin: 0; max-width: var(--measure); }
  dt { font-weight: 700; margin-top: var(--space-4); }
  dd { margin: var(--space-1) 0 0; color: var(--color-ink-muted); }
</style>
