---
/**
 * The team as photo cards. Hovering or focusing a card lays the clinician's special interests over
 * the photo. On a phone the cards are one row that scrolls sideways and snaps.
 */
import Icon from '@/core/ui/Icon.astro';
import { morph } from '@/core/morph';
import Photo from '@/core/ui/Photo.astro';
import SectionHeading from '@/core/ui/SectionHeading.astro';
import type { MarketId } from '@/domain/markets';
import { initials, registrationFor } from '@/modules/providers/registration';

type Provider = Parameters<typeof registrationFor>[0] & { slug: string; name: string; role: string; photoSlot: string; interests?: string[] };
interface Props {
  providers: Provider[];
  variants: { id: MarketId }[];
  lede?: string;
}
const { providers, variants, lede } = Astro.props;
---

<section id="team" class="section" aria-labelledby="team-title">
  <div class="wrap">
    <SectionHeading id="team-title" title="Our team" eyebrow="Who you will see" lede={lede}>
      <a class="text-link all" href="/team/">Meet the whole team <Icon name="arrow-right" size={18} /></a>
    </SectionHeading>
    <ul class="grid" data-reveal-group>
      {providers.map((p) => (
        <li>
          <div class="pic" style={morph('provider', p.slug)}>
            <Photo slot={p.photoSlot} alt={`${p.name}, ${p.role}`} initials={initials(p.name)} ratio="4 / 5" sizes="(min-width: 768px) 22rem, 72vw" />
            {/* Not clipped by a rounded wrapper: the overlay carries its own radius, and the initials tile keeps its corner. */}
            <div class="over" aria-hidden="true">
              {p.interests && p.interests.length > 0 && (
                <ul>
                  {p.interests.slice(0, 3).map((i) => <li>{i}</li>)}
                </ul>
              )}
              <span class="view">View profile <Icon name="arrow-right" size={18} /></span>
            </div>
          </div>
          <h3><a href={`/team/${p.slug}/`}>{p.name}</a></h3>
          <p>{p.role}</p>
          {variants.map((v) => {
            const r = registrationFor(p, v.id);
            return <p class="reg" data-market-only={v.id}>{r.body} {r.number}</p>;
          })}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .all { display: inline-flex; align-items: center; gap: var(--space-1); min-height: var(--target); font-weight: 600; }
  /* Phone: one snapping row that bleeds to the screen edge. */
  .grid {
    display: flex; gap: var(--space-4); margin: 0 calc(-1 * var(--gutter)); padding: var(--space-2) var(--gutter) var(--space-4); list-style: none;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); overscroll-behavior-x: contain; scrollbar-width: none;
  }
  .grid::-webkit-scrollbar { display: none; }
  .grid > li {
    position: relative; flex: 0 0 72%; scroll-snap-align: start;
    display: grid; gap: var(--space-1); align-content: start; padding: var(--space-3) var(--space-3) var(--space-4);
    background: var(--color-card); border: var(--hairline); border-radius: var(--radius-card); box-shadow: var(--shadow-1);
  }
  @media (min-width: 768px) {
    .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); margin: 0; padding: 0; overflow: visible; }
  }

  .pic { position: relative; margin-bottom: var(--space-2); }
  .pic :global(.photo) { border: 0; border-radius: calc(var(--radius-card) - 4px); }
  .over {
    position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; gap: var(--space-3);
    padding: var(--space-4); border-radius: calc(var(--radius-card) - 4px);
    background: linear-gradient(180deg, transparent 20%, color-mix(in srgb, var(--color-deep) 88%, transparent) 78%);
    color: var(--color-on-deep); opacity: 0; transition: opacity var(--dur-2) var(--ease-out), display var(--dur-2) allow-discrete;
  }
  /* Out of the box until asked for, so nothing invisible sits over the photo; it fades in from the starting style. */
  .grid > li:not(:hover, :focus-within) .over { display: none; }
  .over ul { display: grid; gap: var(--space-1); margin: 0; padding: 0; list-style: none; font-size: var(--text-14); line-height: 1.35; }
  .over li::before { content: ''; display: inline-block; width: 0.375rem; height: 0.375rem; margin-right: var(--space-2); vertical-align: middle; background: currentColor; border-radius: 50%; }
  .view { display: inline-flex; align-items: center; gap: var(--space-1); font-weight: 600; }
  .grid > li:is(:hover, :focus-within) .over { opacity: 1; }
  @starting-style { .grid > li:is(:hover, :focus-within) .over { opacity: 0; } }
  @media (hover: hover) and (pointer: fine) {
    :global(html:not([data-motion='off'])) .grid > li:hover :global(.photo img) { transform: scale(1.04); }
  }

  h3 { padding-inline: var(--space-2); font-size: var(--text-24); }
  /* One link per card, stretched over the whole box, so the photo is part of the target. */
  h3 a { text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius-card); }
  .grid > li > p { padding-inline: var(--space-2); color: var(--color-ink-muted); }
  .reg { font-size: var(--text-14); }
</style>
