---
/** Address, hours, directions link and building accessibility notes, per market. */
import type { MarketId, MarketPack } from '@/domain/markets';
import type { Clinic } from '@/domain/types';

interface Props {
  variants: { id: MarketId; market: MarketPack; clinic: Clinic; tel: string; hours: string[] }[];
}
const { variants } = Astro.props;
---

<section id="location" aria-labelledby="location-title">
  <h2 id="location-title">Find us</h2>
  {variants.map(({ id, clinic: c, tel, hours }) => (
    <div class="where" data-market-only={id}>
      <address>{c.address.street}, {c.address.locality} {c.address.region} {c.address.postcode}</address>
      <a class="link" href={`https://www.openstreetmap.org/?mlat=${c.map.lat}&mlon=${c.map.lng}#map=17/${c.map.lat}/${c.map.lng}`}>Open the map and directions</a>
      <ul>{hours.map((h) => <li>{h}</li>)}</ul>
      <p><a class="link" href={tel}>{c.phone}</a></p>
      <p>Step-free entrance and an accessible toilet. <a class="link" href="/accessibility/">Accessibility details</a></p>
    </div>
  ))}
</section>

<style>
  .where { display: grid; gap: var(--space-2); justify-items: start; }
  address { font-style: normal; }
  ul { margin: 0; padding-left: var(--space-5); }
  p { margin: 0; }
  .link { display: inline-flex; align-items: center; min-height: var(--target); text-decoration: underline; }
</style>
