---
/** Plain statements of what a visitor can rely on. Lines come from the clinic (per market) or the preset. */
import type { MarketId, MarketPack } from '@/domain/markets';
import type { Clinic } from '@/domain/types';

interface Props {
  variants: { id: MarketId; market: MarketPack; clinic: Clinic }[];
  /** The preset's default lines, used when a clinic sets no `trust` of its own. */
  presetTrust: string[];
  pricesOn: boolean;
  ownershipOn: boolean;
}
const { variants, presetTrust, pricesOn, ownershipOn } = Astro.props;

function lines(c: Clinic): string[] {
  return [...(c.trust ?? presetTrust), ...(pricesOn ? ['Price list published'] : []), ...(ownershipOn ? ['Ownership statement published'] : [])];
}
---

{variants.map((v) => (
  <ul class="trust" data-market-only={v.id} aria-label="Why people trust us">
    {lines(v.clinic).map((t) => <li>{t}</li>)}
  </ul>
))}

<style>
  .trust { list-style: none; margin: 0 auto; padding: var(--space-4); max-width: 72rem; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); }
  li { min-height: var(--target); display: flex; align-items: center; }
</style>
