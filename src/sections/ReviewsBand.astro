---
/** Reviews section: every market's mode is rendered so ?market= switching works. */
import SectionHeading from '@/core/ui/SectionHeading.astro';
import type { MarketId, MarketPack } from '@/domain/markets';
import type { Clinic } from '@/domain/types';
import Reviews from '@/modules/reviews/Reviews.astro';
import { hasReviewContent, reviewMode, showsRatings, type Review } from '@/modules/reviews/reviews';
import { formatRating } from '@/modules/stats/metrics';

interface Props {
  /** `items` are already worded for the market: suburb picked, service as its title. */
  variants: { id: MarketId; market: MarketPack; clinic: Clinic; items: Review[] }[];
  /** The clinic's published aggregate. Without one the average of the reviews on the page is shown. */
  rating?: { value: number; count: number };
}
const { variants, rating } = Astro.props;
const empty = variants.filter((v) => !hasReviewContent(reviewMode(v.market), v.items.length, v.clinic.reviewsUrl)).map((v) => v.id);
const shown = (items: Review[]) => {
  if (rating) return { value: rating.value.toFixed(1), note: `Based on ${rating.count.toLocaleString('en')} Google reviews` };
  const mean = formatRating(items.map((r) => r.rating));
  return mean ? { value: mean, note: `From ${items.length} published reviews` } : undefined;
};
---

{empty.length < variants.length && (
  <section id="reviews" class="section reviews" aria-labelledby="reviews-title" data-empty={empty.join(' ')}>
    <div class="wrap">
      <SectionHeading id="reviews-title" title="What patients say" eyebrow="Patient experience" />
      {variants.map((v) => (
        <div data-market-only={v.id} data-reveal>
          {/* The average rides inside the market block, so a market that shows no quote never shows the number behind it. */}
          <Reviews items={v.items} mode={reviewMode(v.market)} googleUrl={v.clinic.reviewsUrl} locale={v.market.locale} rating={showsRatings(v.market) ? shown(v.items) : undefined} />
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .reviews { background: var(--color-surface); }
</style>

<style is:global>
  /* No heading over an empty band: hide it in a market that has nothing to show. */
  html[data-market='AU'] #reviews[data-empty~='AU'],
  html[data-market='CA'] #reviews[data-empty~='CA'],
  html[data-market='UK'] #reviews[data-empty~='UK'] { display: none; }
</style>
