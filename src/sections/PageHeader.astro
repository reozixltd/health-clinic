---
interface Props {
  title: string;
  lede?: string;
}
const { title, lede } = Astro.props;
---

<section class="page-header">
  <h1>{title}</h1>
  {lede && <p>{lede}</p>}
</section>

<style>
  .page-header { max-width: 72rem; margin: 0 auto; padding: var(--space-7) var(--space-4) var(--space-5); display: grid; gap: var(--space-3); }
  p { font-size: var(--text-18); color: var(--color-ink-muted); }
</style>
