---
/**
 * The opening band: headline, lead, the two primary actions and the after-hours note, beside one
 * large photo with small cards floating over its edge. It slides under the header's clear main
 * row, like PageHeader. The copy rises in on load and the cards drift a little as the page scrolls.
 */
import Button from '@/core/ui/Button.astro';
import Chip from '@/core/ui/Chip.astro';
import Eyebrow from '@/core/ui/Eyebrow.astro';
import Icon from '@/core/ui/Icon.astro';
import type { IconName } from '@/core/ui/icons';
import Photo from '@/core/ui/Photo.astro';
import type { MarketId } from '@/domain/markets';
import type { Preset } from '@/domain/presets';
import type { Clinic } from '@/domain/types';
import EmergencyNote from '@/modules/emergency/EmergencyNote.astro';

interface Float {
  icon: IconName;
  title: string;
  text?: string;
  /** A review rating. The page only ever builds one for a market that displays ratings. */
  rating?: boolean;
}
interface Props {
  eyebrow?: string;
  headline: string;
  lead: string;
  preset: Preset;
  /** `floats`: at most two cards over the photo, chosen per market by the page. */
  variants: { id: MarketId; clinic: Clinic; tel: string; floats: Float[] }[];
  bookingOn: boolean;
  emergencyOn: boolean;
  photo?: { slot: string; alt: string; focus?: string };
  /** Service shortcuts, already limited by the page. */
  quickLinks: { label: string; href: string }[];
}
const { eyebrow, headline, lead, preset, variants, bookingOn, emergencyOn, photo, quickLinks } = Astro.props;
---

<section class:list={['hero', photo && 'has-photo']} aria-labelledby="hero-title">
  <div class="wrap inner">
    <div class="copy">
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      <h1 id="hero-title">{headline}</h1>
      <p class="lead">{lead}</p>

      {variants.map((v) => (
        <div class="actions" data-market-only={v.id}>
          {bookingOn && <Button href="/book/" size="lg" arrow>{preset.copy.bookLabel}</Button>}
          <a class="phone" href={v.tel}>
            <span class="phone__icon"><Icon name="phone" size={18} /></span>
            Call {v.clinic.phone}
          </a>
          {emergencyOn && <EmergencyNote clinic={v.clinic} preset={preset} compact />}
        </div>
      ))}

      {quickLinks.length > 0 && (
        <nav class="quick" aria-label="Popular services">
          <ul>
            {quickLinks.map((q) => (
              <li><Chip href={q.href}>{q.label}</Chip></li>
            ))}
          </ul>
        </nav>
      )}
    </div>

    {photo && (
      <div class="art" style={photo.focus ? `--focus: ${photo.focus}` : undefined}>
        <span class="blob" aria-hidden="true"></span>
        <Photo slot={photo.slot} alt={photo.alt} ratio="1 / 1" sizes="(min-width: 1024px) 36rem, 100vw" priority />
        {variants.map((v) =>
          v.floats.slice(0, 2).map((f, i) => (
            <p class:list={['float', i === 0 ? 'float--a' : 'float--b']} data-market-only={v.id} data-rating={f.rating || undefined}>
              <span class:list={['float__icon', f.rating && 'float__icon--star']}><Icon name={f.icon} size={20} /></span>
              <span class="float__text">
                <strong>{f.title}</strong>
                {f.text && <span>{f.text}</span>}
              </span>
            </p>
          )),
        )}
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative; overflow: clip;
    margin-top: calc(-1 * var(--header-h));
    padding: calc(var(--header-h) + var(--space-6)) 0 var(--space-8);
    background: linear-gradient(180deg, var(--color-surface), var(--color-paper));
  }
  .inner { display: grid; gap: var(--space-7); align-items: center; }
  @media (min-width: 1024px) {
    .hero { padding-bottom: var(--space-9); }
    .has-photo .inner { grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr); gap: var(--space-8); }
  }

  .copy { display: grid; gap: var(--space-4); justify-items: start; }
  h1 { max-width: 15ch; }
  .lead { max-width: 34rem; color: var(--color-ink-muted); font-size: var(--text-lead); }

  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); margin-top: var(--space-2); }
  .actions :global(.emergency-note) { flex-basis: 100%; font-size: var(--text-14); }
  .phone { display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--target); font-weight: 600; text-decoration: none; }
  .phone__icon { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; background: var(--color-card); border: var(--hairline); border-radius: 50%; color: var(--color-primary-text); }
  @media (hover: hover) and (pointer: fine) { .phone:hover { text-decoration: underline; } }

  .quick ul { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; }
  .quick :global(.chip) { background: var(--color-card); }

  /* The photo, a leaf-shaped mask, and decoration behind it. Everything is placed with inset, so
     it holds its place under reduced motion, where transforms are flattened. */
  .art { position: relative; }
  .art :global(.photo), .art :global(.ph) {
    position: relative; z-index: 1; border: 0;
    border-radius: 9rem var(--radius-panel) 9rem var(--radius-panel);
    box-shadow: var(--shadow-3);
  }
  .art :global(.photo img) { object-position: var(--focus, center); }
  @media (max-width: 1023px) {
    .art :global(.photo), .art :global(.ph) { aspect-ratio: 4 / 3 !important; border-radius: 5rem var(--radius-panel) 5rem var(--radius-panel); }
  }
  .blob {
    position: absolute; inset: -9% -14% auto auto; width: 74%; aspect-ratio: 1;
    background: var(--color-accent); border-radius: 46% 54% 60% 40% / 48% 42% 58% 52%;
  }
  .art::after {
    content: ''; position: absolute; inset: auto auto -8% -10%; width: 44%; aspect-ratio: 1;
    background: var(--color-sand); border-radius: 58% 42% 44% 56% / 46% 56% 44% 54%;
  }

  .float {
    position: absolute; z-index: 2; display: flex; align-items: center; gap: var(--space-3);
    margin: 0; padding: var(--space-3) var(--space-4); max-width: 17rem;
    background: var(--color-card); border: var(--hairline); border-radius: var(--radius-card); box-shadow: var(--shadow-2);
    font-size: var(--text-14); line-height: 1.3;
  }
  /* Top left and bottom right: clear of the face in a photo whose subject sits upper right. */
  .float--a { left: var(--space-3); top: calc(-1 * var(--space-4)); }
  .float--b { right: var(--space-3); bottom: calc(-1 * var(--space-5)); }
  @media (min-width: 1024px) {
    .float--a { left: calc(-1 * var(--space-7)); top: var(--space-8); }
    .float--b { right: calc(-1 * var(--space-4)); bottom: var(--space-7); }
  }
  .float__icon { flex: none; display: grid; place-items: center; width: 2.5rem; height: 2.5rem; background: var(--color-accent); border-radius: 50%; color: var(--color-primary-text); }
  .float__icon--star { background: var(--color-warning-soft); color: var(--color-star); }
  .float__icon--star :global(svg) { fill: currentColor; }
  .float__text { display: grid; }
  .float__text strong { font-size: var(--text-16); }
  .float__text span { color: var(--color-ink-muted); }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes hero-rise { from { opacity: 0; transform: translateY(20px); } }
    /* The photo only settles in scale. It never starts transparent, so the largest paint is not held back. */
    @keyframes hero-settle { from { transform: scale(1.06); } }
    @keyframes hero-drift { to { translate: 0 var(--drift); } }
    :global(html:not([data-motion='off'])) .copy > :global(*) { animation: hero-rise var(--dur-3) var(--ease-out) backwards; }
    :global(html:not([data-motion='off'])) .copy > :nth-child(2) { animation-delay: 70ms; }
    :global(html:not([data-motion='off'])) .copy > :nth-child(3) { animation-delay: 140ms; }
    :global(html:not([data-motion='off'])) .copy > :nth-child(n + 4) { animation-delay: 210ms; }
    :global(html:not([data-motion='off'])) .copy > .quick { animation-delay: 280ms; }
    :global(html:not([data-motion='off'])) .art :global(.photo img) { animation: hero-settle var(--dur-3) var(--ease-out) backwards; }
    :global(html:not([data-motion='off'])) .float { animation: hero-rise var(--dur-3) var(--ease-out) 350ms backwards; }
    :global(html:not([data-motion='off'])) .float--b { animation-delay: 450ms; }

    /* Parallax: the cards and the blob move a little against the photo as the hero scrolls away. */
    @supports (animation-timeline: scroll()) {
      :global(html:not([data-motion='off'])) .blob { --drift: 70px; animation: hero-drift linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
      :global(html:not([data-motion='off'])) .float {
        --drift: -36px;
        animation: hero-rise var(--dur-3) var(--ease-out) 350ms backwards, hero-drift linear both;
        animation-timeline: auto, scroll(root); animation-range: normal, 0 100vh;
      }
      :global(html:not([data-motion='off'])) .float--b { --drift: -64px; animation-delay: 450ms, 0s; }
    }
  }
</style>
