---
import type { Clinic } from '@/domain/types';

interface Props {
  clinic: Clinic;
}
const { clinic } = Astro.props;
const owner = clinic.owner;
---

<div class="statement">
  {owner ? (
    <>
      <p class="lead">
        {owner.independent
          ? `${clinic.name} is independently owned. It is not part of a corporate veterinary group.`
          : `${clinic.name} is part of ${owner.group ?? 'a veterinary group'}.`}
      </p>
      <dl>
        <dt>Owner</dt><dd>{owner.name}</dd>
        {owner.group && <><dt>Group</dt><dd>{owner.group}</dd></>}
        <dt>Registered company</dt><dd>{clinic.legalName}, company number {clinic.legalId}</dd>
      </dl>
    </>
  ) : (
    <p class="lead">Ask us who owns this practice and we will tell you.</p>
  )}
  <p>Questions about ownership? Call us on <a href={`tel:${clinic.phone.replace(/[^\d+]/g, '')}`}>{clinic.phone}</a> or email <a href={`mailto:${clinic.email}`}>{clinic.email}</a>.</p>
</div>

<style>
  .statement { display: grid; gap: var(--space-4); max-width: var(--measure); }
  .lead { margin: 0; font-size: var(--text-22); }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: var(--space-2) var(--space-5); margin: 0; }
  dt { font-weight: 600; }
  dd { margin: 0; }
  p { margin: 0; }
</style>
