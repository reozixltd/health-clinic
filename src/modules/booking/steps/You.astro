---
import Button from '@/core/ui/Button.astro';
import Field from '@/core/ui/Field.astro';

interface Props { postcodeLabel: string; hidden?: boolean }
const { postcodeLabel, hidden = true } = Astro.props;
---

<section class="step" data-step="you" aria-labelledby="h-you" hidden={hidden}>
  <h2 id="h-you" tabindex="-1">Your details</h2>
  <p class="note">Please don't include medical details here. We'll ask what we need when we confirm.</p>
  <div class="pair">
    <Field name="firstName" label="First name" required autocomplete="given-name" />
    <Field name="lastName" label="Last name" required autocomplete="family-name" />
  </div>
  <Field name="phone" label="Mobile number" type="tel" required autocomplete="tel" inputmode="tel" />
  <Field name="email" label="Email" type="email" required autocomplete="email" inputmode="email" />
  <Field name="postcode" label={postcodeLabel} required autocomplete="postal-code" />
  <div class="trap" aria-hidden="true">
    <label for="website">Leave this empty</label>
    <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <div class="nav">
    <Button variant="secondary" data-back>Back</Button>
    <Button data-next>Continue</Button>
  </div>
</section>
