---
/**
 * One clinician: portrait and booking beside the long read. Registration shows for every market
 * variant. Interests, qualifications, clinic days and the Markdown body show only when the
 * clinician's file has them. The default slot takes that body.
 */
import Button from '@/core/ui/Button.astro';
import Chip from '@/core/ui/Chip.astro';
import Icon from '@/core/ui/Icon.astro';
import Photo from '@/core/ui/Photo.astro';
import type { MarketId } from '@/domain/markets';
import type { Clinic } from '@/domain/types';
import { firstName, initials, registrationFor } from './registration';

interface Props {
  provider: {
    slug: string; name: string; role: string; languages: string[]; acceptingNew: boolean; photoSlot: string;
    registration: { body: string; number: string; byMarket?: Partial<Record<MarketId, { body: string; number: string }>> };
    qualifications?: string[]; interests?: string[]; availability?: string[]; joined?: number;
  };
  services: { slug: string; title: string }[];
  variants: { id: MarketId; clinic: Pick<Clinic, 'registerUrl'> }[];
  bookingOn: boolean;
}
const { provider, services, variants, bookingOn } = Astro.props;
const { qualifications = [], interests = [], availability = [] } = provider;
const first = firstName(provider.name);
const body = Astro.slots.has('default') ? (await Astro.slots.render('default')).trim() : '';
const week = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'].filter((d) => d !== 'Sunday' || availability.includes(d));
---

<div class="wrap page-body cols">
  <aside class="panel side" aria-label={`Booking with ${first}`}>
    <div class="pic"><Photo slot={provider.photoSlot} alt={`${provider.name}, ${provider.role}`} initials={initials(provider.name)} ratio="4 / 5" sizes="(min-width: 1024px) 20rem, (min-width: 640px) 24rem, 100vw" priority /></div>
    {provider.acceptingNew
      ? <p class="status open"><Icon name="badge-check" size={18} /> Taking new patients</p>
      : <p class="status shut"><Icon name="alert" size={18} /> Existing patients only</p>}
    {availability.length > 0 && (
      <div class="days">
        <h2>In the clinic</h2>
        <p class="visually-hidden">{availability.join(', ')}</p>
        <ul aria-hidden="true">
          {week.map((d) => <li class:list={{ on: availability.includes(d) }}>{d.slice(0, 3)}</li>)}
        </ul>
      </div>
    )}
    {bookingOn && <Button href={`/book/?provider=${provider.slug}`} arrow>Book with {first}</Button>}
  </aside>

  <div class="main">
    {body && <div class="prose" set:html={body} />}

    {interests.length > 0 && (
      <section aria-labelledby="interests" data-reveal>
        <h2 id="interests">Special interests</h2>
        <ul class="tags">{interests.map((i) => <li>{i}</li>)}</ul>
      </section>
    )}

    {qualifications.length > 0 && (
      <section aria-labelledby="quals" data-reveal>
        <h2 id="quals">Qualifications</h2>
        <ul class="quals">{qualifications.map((q) => <li><Icon name="award" size={20} /> {q}</li>)}</ul>
      </section>
    )}

    <section aria-labelledby="details" data-reveal>
      <h2 id="details">Registration and details</h2>
      <dl>
        <div class="row">
          <dt>Registration</dt>
          {variants.map((v) => {
            const r = registrationFor(provider, v.id);
            return (
              <dd data-market-only={v.id}>
                {v.clinic.registerUrl ? <a href={v.clinic.registerUrl} rel="noopener">{r.body}</a> : r.body}, registration number {r.number}
              </dd>
            );
          })}
        </div>
        <div class="row">
          <dt>Languages</dt>
          <dd>{provider.languages.join(', ')}</dd>
        </div>
        <div class="row">
          <dt>New patients</dt>
          <dd>{provider.acceptingNew ? 'Accepting new patients' : 'Not accepting new patients. Existing patients are welcome to book.'}</dd>
        </div>
        {provider.joined && (
          <div class="row">
            <dt>With us since</dt>
            <dd>{provider.joined}</dd>
          </div>
        )}
      </dl>
    </section>

    {services.length > 0 && (
      <section aria-labelledby="sv" data-reveal>
        <h2 id="sv">Services</h2>
        <ul class="links">{services.map((s) => <li><Chip href={`/services/${s.slug}/`}>{s.title} <Icon name="arrow-right" size={16} /></Chip></li>)}</ul>
      </section>
    )}
  </div>
</div>

<style>
  .cols { align-items: start; }
  .main { display: grid; gap: var(--space-7); }
  section { display: grid; gap: var(--space-4); }
  h2 { font-size: var(--text-28); }
  .prose { font-size: var(--text-18); }

  .side { display: grid; gap: var(--space-4); padding: var(--space-3) var(--space-3) var(--space-5); }
  .side > :not(.pic) { margin-inline: var(--space-3); }
  .pic :global(.photo) { border: 0; border-radius: calc(var(--radius-panel) - var(--space-3)); }
  .status { display: flex; align-items: center; gap: var(--space-2); font-weight: 700; }
  .open { color: var(--color-success); }
  .shut { color: var(--color-warning); }
  .days { display: grid; gap: var(--space-2); }
  .days h2 { font-family: var(--font-body); font-size: var(--text-14); font-weight: 700; letter-spacing: var(--track-label); text-transform: uppercase; color: var(--color-ink-muted); }
  .days ul, .tags, .quals, .links { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .days li { flex: 1; padding: var(--space-2) 0; background: var(--color-surface); border-radius: var(--radius-control); color: var(--color-ink-muted); font-size: var(--text-14); text-align: center; }
  .days .on { background: var(--color-primary); color: var(--color-on-ink); font-weight: 700; }
  .side :global(.btn) { justify-content: center; }

  .tags li { padding: var(--space-2) var(--space-4); background: var(--color-accent); border-radius: var(--radius-pill); font-weight: 600; }
  .tags li::first-letter { text-transform: uppercase; }
  .quals { display: grid; gap: var(--space-3); }
  .quals li { display: flex; align-items: center; gap: var(--space-3); }
  .quals :global(svg) { flex: none; color: var(--color-primary-text); }

  dl { display: grid; max-width: var(--measure); }
  .row { display: grid; gap: var(--space-1); padding-block: var(--space-3); border-top: var(--hairline); }
  @media (min-width: 640px) { .row { grid-template-columns: 11rem 1fr; gap: var(--space-4); } }
  dt { color: var(--color-ink-muted); }
  dd { font-weight: 600; }
  dd a { color: var(--color-primary-text); }

  @media (min-width: 640px) and (max-width: 1023px) { .side { max-width: 26rem; } }
  @media (min-width: 1024px) {
    .cols { grid-template-columns: 22rem minmax(0, 1fr); gap: var(--space-9); }
    .side { position: sticky; top: calc(var(--header-h) + var(--utility-h) + var(--space-5)); }
  }
</style>
