---
/** Team as ruled rows with a small photo, name, role and whether they are taking new patients. */
import Photo from '@/core/ui/Photo.astro';
import { initials } from './registration';

interface Props {
  providers: { slug: string; name: string; role: string; languages: string[]; acceptingNew: boolean; photoSlot: string }[];
}
const { providers } = Astro.props;
---

<ul class="rows" data-reveal-group>
  {providers.map((p) => (
    <li class="row">
      <Photo slot={p.photoSlot} alt={`${p.name}, ${p.role}`} initials={initials(p.name)} ratio="1 / 1" sizes="96px" class="pic" />
      <div>
        <h2><a href={`/team/${p.slug}/`}>{p.name}</a></h2>
        <p>{p.role}. Speaks {p.languages.join(', ')}.</p>
        {!p.acceptingNew && <p class="note">Not accepting new patients</p>}
      </div>
    </li>
  ))}
</ul>

<style>
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-line); }
  .row { display: grid; grid-template-columns: 96px 1fr; gap: var(--space-4); align-items: center; padding: var(--space-4) 0; border-bottom: 1px solid var(--color-line); }
  h2 { font-size: var(--text-24); }
  h2 a { display: inline-flex; align-items: center; min-height: var(--target); }
  p { color: var(--color-ink-muted); }
  .note { color: var(--color-warning); font-weight: 600; }
  @media (hover: hover) { :global(html:not([data-motion='off'])) .row:hover :global(.photo img) { transform: scale(1.03); } }
</style>
