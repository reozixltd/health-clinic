---
/** Fees for one market: a table per service, with the funding notes that apply to each fee. */
import { groupByService, type FeeRow } from './funding';

interface Props {
  rows: FeeRow[];
  titles: Record<string, string>;
}
const { rows, titles } = Astro.props;
const groups = groupByService(rows);
---

<div class="fees">
  {groups.map((g) => (
    <section aria-labelledby={`fees-${g.service}`}>
      <h2 id={`fees-${g.service}`}>{titles[g.service] ?? g.service}</h2>
      <table>
        <thead class="sr-only"><tr><th scope="col">Visit</th><th scope="col">Fee</th><th scope="col">Cover</th></tr></thead>
        <tbody>
          {g.rows.map((r) => (
            <tr>
              <th scope="row">{r.label}</th>
              <td class="price">{r.price}</td>
              <td class="notes">{r.notes.length ? r.notes.join('. ') : ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}
</div>

<style>
  .fees { display: grid; gap: var(--space-6); }
  section { display: grid; gap: var(--space-3); }
  h2 { margin: 0; font-size: var(--text-22); }
  table { width: 100%; border-collapse: collapse; }
  tr { border-top: 1px solid var(--color-line); }
  th, td { padding: var(--space-3) var(--space-2); text-align: left; vertical-align: top; }
  th { font-weight: 400; }
  .price { font-weight: 600; white-space: nowrap; }
  .notes { color: var(--color-ink-muted); }
  @media (max-width: 639px) {
    tr { display: grid; grid-template-columns: 1fr auto; }
    .notes { grid-column: 1 / -1; padding-top: 0; }
  }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
