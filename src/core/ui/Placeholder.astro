---
/** Stand-in for a photo that has not been supplied: a soft brand gradient, an icon and a label. Never a grey box. */
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  label: string;
  ratio?: string;
  icon?: IconName;
  class?: string;
}
const { label, ratio = '4 / 3', icon = 'leaf', class: className } = Astro.props;
---

<figure class:list={['ph', className]} style={`aspect-ratio: ${ratio}`} role="img" aria-label={`Photo placeholder: ${label}`}>
  <span class="ph__mark"><Icon name={icon} size={32} /></span>
  <span class="ph__label">{label}</span>
</figure>

<style>
  .ph {
    position: relative;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-3);
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-card);
    background:
      radial-gradient(60% 70% at 85% 10%, color-mix(in srgb, var(--color-card) 70%, transparent), transparent 70%),
      radial-gradient(70% 80% at 5% 100%, color-mix(in srgb, var(--color-primary) 22%, transparent), transparent 70%),
      linear-gradient(135deg, var(--color-accent), var(--color-sand));
    color: var(--color-ink);
  }
  .ph__mark {
    display: grid; place-items: center; width: 4rem; height: 4rem;
    background: color-mix(in srgb, var(--color-card) 75%, transparent);
    border-radius: 42% 58% 55% 45% / 52% 44% 56% 48%;
    color: var(--color-primary-text);
  }
  .ph__label { padding: 0 var(--space-3); font-size: var(--text-14); font-weight: 600; text-align: center; }
</style>
