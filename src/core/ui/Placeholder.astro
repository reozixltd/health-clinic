---
/** Labelled stand-in for a photo that has not been supplied. Plainly a placeholder, never a stock image. */
interface Props {
  label: string;
  ratio?: string;
  class?: string;
}
const { label, ratio = '4 / 3', class: className } = Astro.props;
---

<figure class:list={['ph', className]} style={`aspect-ratio: ${ratio}`} role="img" aria-label={`Photo placeholder: ${label}`}>
  <span class="ph__label">{label}</span>
</figure>

<style>
  .ph {
    position: relative;
    display: grid;
    place-items: center;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    color: var(--color-ink-muted);
  }
  .ph__label { padding: var(--space-2) var(--space-3); font-size: var(--text-14); text-align: center; }
</style>
