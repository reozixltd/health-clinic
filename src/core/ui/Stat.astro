---
/** One metric tile: a number, what it counts, and a note. */
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  value: string;
  label: string;
  note?: string;
  icon: IconName;
  class?: string;
}
const { value, label, note, icon, class: className } = Astro.props;
---

<div class:list={['stat', className]}>
  <span class="stat__icon"><Icon name={icon} size={28} /></span>
  <p class="stat__value">{value}</p>
  <p class="stat__label">{label}</p>
  {note && <p class="stat__note">{note}</p>}
</div>

<style>
  .stat {
    box-sizing: border-box;
    display: grid;
    gap: var(--space-2);
    align-content: start;
    /* No justify-items: start, unlike a container of mixed content. A tile IS the content: it
       should fill its cell so a row of tiles comes out equal width with its tops aligned, and
       justify-items: start would shrink each to its text and reintroduce ragged edges. */
    padding: var(--space-5);
    background: var(--color-card);
    border: var(--hairline);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-1);
  }
  /* Decoration, so --color-ink-muted like the note rather than the saturated --color-primary,
     which design-system.md scopes to fills, borders and large display text. It is aria-hidden and
     carries no meaning; a saturated 28px mark read as meaningful beside three ink-weight lines. */
  .stat__icon { color: var(--color-ink-muted); }
  .stat__value { font-family: var(--font-display); font-size: var(--text-36); font-weight: 520; line-height: 1.1; letter-spacing: var(--track-heading); }
  .stat__label { font-weight: 600; }
  .stat__note { color: var(--color-ink-muted); font-size: var(--text-14); }
</style>