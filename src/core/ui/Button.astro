---
/** Button or link styled as a button. `primary` is the ink fill; `secondary` is outlined; `quiet` is text-only. */
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'type'> {
  href?: string;
  variant?: 'primary' | 'secondary' | 'quiet';
  size?: 'md' | 'lg';
  type?: 'button' | 'submit';
}

const { href, variant = 'primary', size = 'md', type = 'button', class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag href={href} type={href ? undefined : type} class:list={['btn', `btn--${variant}`, `btn--${size}`, className]} {...rest}>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--target);
    padding: 0 var(--space-5);
    border: 1px solid transparent;
    border-radius: var(--radius-control);
    font-size: var(--text-16);
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition: transform var(--dur-fill) cubic-bezier(0.23, 1, 0.32, 1);
  }
  .btn--lg { min-height: 3.25rem; padding: 0 var(--space-6); font-size: var(--text-18); }
  .btn:active:not([disabled]) { transform: scale(0.97); }
  .btn--primary { background: var(--color-ink); color: var(--color-on-ink); border-color: var(--color-ink); }
  .btn--secondary { background: var(--color-card); color: var(--color-ink); border-color: var(--color-field-border); }
  .btn--quiet { background: transparent; color: var(--color-ink); }
  @media (hover: hover) and (pointer: fine) {
    .btn--primary:hover:not([disabled]) { background: var(--color-ink-muted); color: var(--color-on-ink); }
    .btn--secondary:hover:not([disabled]) { border-color: var(--color-ink); background: var(--color-surface); }
    .btn--quiet:hover:not([disabled]) { background: var(--color-surface); }
  }
  .btn[disabled] { opacity: 0.55; cursor: not-allowed; }
</style>
