---
/**
 * A stand-in logo: one of six plain geometric marks beside a name. Drawn here on purpose, so a
 * sample site never borrows a real company's mark. Takes the text colour.
 */
interface Props {
  name: string;
  mark: number;
}
const { name, mark } = Astro.props;
const MARKS = [
  '<circle cx="14" cy="14" r="10.5" fill="none" stroke="currentColor" stroke-width="2.5"/><circle cx="14" cy="14" r="4.5"/>',
  '<circle cx="10" cy="14" r="8" opacity=".5"/><circle cx="18" cy="14" r="8" opacity=".85"/>',
  '<path d="M2 24 11 6l5 9 3-5 7 14z"/>',
  '<rect x="3" y="3" width="22" height="22" rx="7" opacity=".3"/><path d="M8 19c0-7 4-10 12-10 0 8-4 12-12 10z"/>',
  '<rect x="4" y="13" width="5" height="11" rx="2.5"/><rect x="11.5" y="8" width="5" height="16" rx="2.5"/><rect x="19" y="3" width="5" height="21" rx="2.5"/>',
  '<path d="M4 18a10 10 0 0 1 20 0z"/><rect x="2" y="21" width="24" height="3" rx="1.5" opacity=".55"/>',
];
---

<span class="fund">
  <svg viewBox="0 0 28 28" width="28" height="28" fill="currentColor" aria-hidden="true" set:html={MARKS[(mark - 1) % MARKS.length]} />
  <span>{name}</span>
</span>

<style>
  .fund {
    display: inline-flex; align-items: center; gap: var(--space-2);
    color: var(--color-ink-muted);
    font-family: var(--font-display); font-size: var(--text-20); font-weight: 600; letter-spacing: var(--track-heading);
    white-space: nowrap;
  }
  svg { flex: none; }
</style>
