---
/**
 * Photo for a named slot (src/assets/images/<slot>.<ext>). With a file: optimised <Picture>
 * (AVIF + WebP), space reserved by `ratio`, lazy unless `priority`. Without one: a labelled Placeholder.
 */
import { Picture } from 'astro:assets';
import { getPhoto } from '../photos';
import Placeholder from './Placeholder.astro';

interface Props {
  slot: string;
  alt: string;
  ratio?: string;
  sizes?: string;
  priority?: boolean;
  /** Shown instead of the placeholder when the slot has no file (clinician portraits). */
  initials?: string;
  class?: string;
}

const { slot, alt, ratio = '4 / 3', sizes = '(min-width: 1024px) 33vw, 100vw', priority = false, initials, class: className } = Astro.props;
const image = getPhoto(slot);
const widths = image ? [480, 800, 1200, 1600].filter((w) => w <= image.width) : [];
---

{
  image ? (
    <figure class:list={['photo', className]} style={`aspect-ratio: ${ratio}`}>
      <Picture
        src={image}
        alt={alt}
        formats={['avif', 'webp']}
        widths={widths.length ? widths : [image.width]}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
    </figure>
  ) : initials ? (
    <figure class:list={['photo', 'initials', className]} style={`aspect-ratio: ${ratio}`} role="img" aria-label={alt}>
      <span aria-hidden="true">{initials}</span>
    </figure>
  ) : (
    <Placeholder label={alt} ratio={ratio} class={className} />
  )
}

<style>
  .photo { box-sizing: border-box; margin: 0; overflow: hidden; border: 1px solid var(--color-line); border-radius: var(--radius-card); background: var(--color-surface); }
  .photo :global(picture), .photo :global(img) { display: block; width: 100%; height: 100%; }
  .photo :global(img) { object-fit: cover; }
  .photo :global(img) { transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1); }
  /*
   * A real photo is a full-bleed panel, so --radius-card is right for .photo and it stays. The
   * initials tile is an avatar, and no shipped composition renders it below 160px: the home team
   * band and /team/ are card grids, so the tile is 320px or more and takes the card curve anyway.
   * The sub-threshold branch below is kept because the component is shared, and a compact row is
   * the obvious thing for a future section to add; the test that covers it constrains the tile in
   * the browser rather than relying on a page that happens to be small.
   *
   * That radius lives on the span, not the figure, and for two separate reasons:
   *
   *   1. `.initials` is the inline-size container and an element cannot query its own container, so
   *      only a descendant can answer with the tile's own width.
   *   2. `.photo` sets `overflow: hidden`, and an ancestor's overflow clips descendants to the
   *      ancestor's own rounded padding box. So a radius left on the figure silently masks the
   *      smaller radius on the span, whatever the span computes to. Measured: the span is 8px while
   *      the tile still draws a 16px corner.
   *
   * Hence border, fill AND radius all move onto the span, and the figure gives up all three. The
   * figure keeps `overflow` so nothing escapes the aspect-ratio box, and keeps role/aria-label, so
   * the tile is still announced as one image. tests/e2e/photos.e2e.mjs measures the rendered corner
   * on each side of the threshold, so a missing reset here fails rather than passing quietly.
   */
  .photo.initials { border: 0; border-radius: 0; background: none; }
  .initials { display: grid; place-items: center; container-type: inline-size; color: var(--color-ink); }
  .initials span { place-self: stretch; display: grid; place-items: center; border: 1px solid var(--color-line); border-radius: var(--radius-control); background: var(--color-surface); font-size: min(36cqw, 4rem); font-weight: 700; line-height: 1; }
  @container (min-width: 160px) { .initials span { border-radius: var(--radius-card); } }
</style>
