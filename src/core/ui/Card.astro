---
/**
 * White elevated surface. The one card in the system; components place their own content inside.
 *
 * Set `interactive` when the card is ONE target in the reader's model - the whole box is
 * clickable, whether via an overlay link or via a control that fills it. Leave it off when the
 * card is only a container. Two cases in the plan: ServicesBand cards are interactive, because
 * every link in one leads to the same service page so the box itself reads as the link;
 * Facilities cards are not, because they hold an icon and prose and nothing to click. Deciding
 * this per composition is the point of the prop existing.
 *
 * It is explicit rather than inference from `:has(a), :has(button)`. Inference missed `<summary>`,
 * `input`/`select` and `[role="button"]`, and worse, it matched links that are not on the page:
 * this project hides market variants with CSS (`data-market-only`, global.css), so a card whose
 * only link was `<a data-market-only="UK">` still satisfied `:has(a)` in fernway-au and got the
 * "whole box is a target" border and lift with nothing clickable inside.
 *
 * Preferred whole-card target: put ONE link inside the card and let it cover the card with
 * `position: absolute; inset: 0`, so the whole box is the hit area and the card is a single tab
 * stop. `inset: 0` resolves against the containing block's PADDING box, so the overlay covers the
 * card's padding area as well as its content - which is the intended full-bleed hit area, not a
 * bug. The anchor must be a direct child so it stretches to that box. Note ServicesBand instead
 * links its heading and a trailing "About this service", which is two tab stops to one
 * destination; that is a known imperfection of that composition, not the pattern to copy.
 *
 * `position: relative` is what makes `inset: 0` resolve against the card rather than some distant
 * positioned ancestor. It does so for EVERY absolutely-positioned descendant, not only the
 * overlay: anything inside a card that positions itself now resolves against the card.
 *
 * Deliberately no `justify-items` here: it applies to every grid item, so it would shrink a
 * nested Card to fit its text and collapse a `justify-content: space-between` row to max-content,
 * leaving no free space to distribute. Chip carries its own constraint instead.
 */
interface Props {
  as?: 'div' | 'section' | 'article' | 'li';
  interactive?: boolean;
  class?: string;
}
const { as: Tag = 'div', interactive = false, class: className } = Astro.props;
---

<Tag class:list={['card', interactive && 'card--interactive', className]}><slot /></Tag>

<style>
  .card {
    position: relative;
    box-sizing: border-box;
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-5);
    background: var(--color-card);
    border: var(--hairline);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-1);
    transition: transform var(--dur-2) var(--ease-out);
  }
  /* The deeper hover shadow is its own layer that fades in, so only opacity and transform move.
     An outer shadow paints outside the box, so the layer never covers the card's content. Under
     reduced motion the global rule drops the lift and keeps the fade. */
  .card:where(.card--interactive)::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    box-shadow: var(--shadow-3); opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
  }
  /* An interactive card's resting border is the affordance saying the whole box is a target, so
     it must clear 3:1 against the surface behind it. --color-field-border is the palette's token
     for a load-bearing boundary and measures 4.26-4.54:1. --color-line was 1.22-1.26:1, which is
     fine for a decorative rule but not for this. This is the resting affordance, not a hover one,
     so it sits outside the hover query and applies at every pointer type - on a touch device
     there is no hover to reveal it. :where() keeps this at the base rule's specificity so a
     consumer `class` can still win on source order. */
  .card:where(.card--interactive) { border-color: var(--color-field-border); }
  @media (hover: hover) and (pointer: fine) {
    .card:where(.card--interactive):hover { transform: translateY(-4px); border-color: var(--color-primary); }
    .card:where(.card--interactive):hover::after { opacity: 1; }
  }
</style>